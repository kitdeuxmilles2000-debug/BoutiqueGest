# Copier ce fichier en .env et renseigner les valeurs reelles.
# NE JAMAIS committer le fichier .env.

# Cle secrete Flask (generer une valeur longue et aleatoire)
SECRET_KEY=changez-moi-par-une-cle-longue-et-aleatoire

# Base de donnees (par defaut : SQLite dans instance/)
# DATABASE_URL=sqlite:///C:/chemin/vers/instance/boutiquegest.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/boutiquegest

# Compte administrateur cree par la commande `flask seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangezMoi123!
ADMIN_FULLNAME=Administrateur

# Fuseau horaire d'affichage
TIMEZONE=Africa/Kinshasa

# Securite
SESSION_LIFETIME_HOURS=8
REAUTH_TIMEOUT_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# E-mails (rapport journalier). Si SMTP_HOST est vide, les messages restent
# dans la file d'attente (Administration > E-mails) sans etre envoyes.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=rapports@example.com
# SMTP_PASSWORD=mot-de-passe-application
# SMTP_SENDER=rapports@example.com
# SMTP_USE_TLS=1

# Destinataire par defaut du rapport journalier (une fois cloture validee).
# REPORT_EMAIL_TO=proprietaire@example.com
